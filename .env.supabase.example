# Copia este archivo a .env.supabase.
# Supabase > Connect > Session pooler (normalmente puerto 5432).
DATABASE_URL=postgresql://pos_app.REFERENCIA:CONTRASENA_APP_CODIFICADA@HOST_DEL_POOLER:5432/postgres
# Credencial administrativa separada en .env.migrations; consulta .env.migrations.example.
DATABASE_SSL=true
DATABASE_LABEL=Supabase
# Si necesitas la CA de tu proyecto, descárgala desde su configuración SSL.
# Usa barras / en la ruta, por ejemplo:
# DATABASE_CA_FILE=./certs/prod-supabase.cer
PORT=3000
