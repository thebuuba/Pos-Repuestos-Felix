{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png"
    ],
    "resources": {
      "../dist/windows-payload/app/": null,
      "../dist/windows-payload/runtime/": null,
      "../dist/windows-payload/payload-manifest.json": null,
      "../dist/linux-payload/app/": "app/",
      "../dist/linux-payload/runtime/": "runtime/",
      "../dist/linux-payload/payload-manifest.json": "payload-manifest.json"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "ca-certificates"
        ],
        "section": "office",
        "priority": "optional"
      }
    }
  },
  "plugins": {
    "updater": null
  }
}
