# Copiar a .env.migrations para Supabase o a .env.local.migrations para PostgreSQL local.
# Este archivo solo se carga al ejecutar db:migrate; el servidor web no debe cargarlo.
MIGRATION_DATABASE_URL=postgresql://postgres.REFERENCIA:CONTRASENA_ADMIN_CODIFICADA@HOST_DEL_POOLER:5432/postgres
# Variante local:
# MIGRATION_DATABASE_URL=postgresql://postgres:CONTRASENA_ADMIN@127.0.0.1:5432/pos_repuestos_felix
