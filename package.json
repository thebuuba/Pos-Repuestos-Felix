{
  "name": "pos-repuestos-felix",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.migrations scripts/migrate.js",
    "db:migrate:local": "node --env-file=.env.local --env-file-if-exists=.env.local.migrations scripts/migrate.js",
    "db:migrate:supabase": "node --env-file=.env.supabase --env-file-if-exists=.env.migrations scripts/migrate.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:local": "node --env-file=.env.local src/server.js",
    "start:supabase": "node --env-file=.env.supabase src/server.js",
    "dev:worker": "wrangler dev --local-protocol https",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "wrangler": "4.166.0"
  }
}
