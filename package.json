{
  "name": "pos-repuestos-felix",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "agentes": "node scripts/orchestrate.mjs",
    "usuarios:crear": "powershell -NoProfile -File scripts/crear-usuario.ps1",
    "netpos:prepare": "python scripts/netpos/prepare.py",
    "netpos:import": "node scripts/netpos/import.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.migrations scripts/migrate.js",
    "db:migrate:local": "node --env-file=.env.local --env-file-if-exists=.env.local.migrations scripts/migrate.js",
    "db:migrate:supabase": "node --env-file=.env.supabase --env-file-if-exists=.env.migrations scripts/migrate.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "start:operational": "node src/server.js --operational",
    "start:local": "node --env-file=.env.local src/server.js",
    "start:supabase": "node --env-file=.env.supabase src/server.js",
    "dev:worker": "pnpm build && wrangler dev --assets dist/operational --local-protocol https",
    "build:worker": "pnpm build && wrangler deploy --assets dist/operational --dry-run --outdir dist/worker",
    "build": "node scripts/build-operational.mjs",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-build.ps1",
    "release:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows-release.ps1",
    "prepare:windows": "node scripts/build-windows.mjs",
    "prepare:linux": "node scripts/build-linux.mjs",
    "verify:linux": "node scripts/build-linux.mjs --verify",
    "build:operational": "node scripts/build-operational.mjs",
    "build:design": "node scripts/build-operational.mjs",
    "build:reference": "node scripts/build-design.mjs",
    "preview": "node scripts/serve-design.mjs",
    "preview:design": "node scripts/serve-design.mjs",
    "preview:reference": "node scripts/serve-design.mjs --reference",
    "test:design": "node --test tests/design-preview.test.js",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "test": "pnpm build && node --test --test-concurrency=4 tests/*.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fontsource-variable/inter": "5.3.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.507.0",
    "next-themes": "0.3.0",
    "pg": "^8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "sonner": "1.7.4",
    "tailwind-merge": "2.6.2"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "0.28.2",
    "jsdom": "^31.0.1",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "wrangler": "4.166.0"
  }
}
