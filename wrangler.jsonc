{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repuestos-felix-pos",
  "account_id": "386205735992323ba10df4a616176353",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/operational",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "DATABASE_LABEL": "Supabase - Repuestos Felix",
    "PUBLIC_ORIGIN": "https://repuestos-felix-pos.repuestosfelix1994.workers.dev"
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "1687e8b168374a5d8478baf4c0d6eeb0" }],
  "secrets": { "required": ["SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "POS_SESSION_SECRET"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
