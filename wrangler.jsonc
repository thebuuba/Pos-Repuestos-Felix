{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repuestos-felix-pos",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "DATABASE_LABEL": "Supabase - Repuestos Felix",
    "PUBLIC_ORIGIN": ""
  },
  "hyperdrive": [],
  "secrets": { "required": ["SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "POS_SESSION_SECRET"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
